    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wasmer/sdk": "^0.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
